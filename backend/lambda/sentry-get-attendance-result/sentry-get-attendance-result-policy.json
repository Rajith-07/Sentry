{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "DynamoDBReadAttendanceRecord",
			"Effect": "Allow",
			"Action": [
				"dynamodb:GetItem"
			],
			"Resource": [
				"arn:aws:dynamodb:<REGION>:<Account_ID>:table/sentry-attendance-event-log"
			]
		},
		{
			"Sid": "CloudWatchLogsAccess",
			"Effect": "Allow",
			"Action": [
				"logs:CreateLogGroup",
				"logs:CreateLogStream",
				"logs:PutLogEvents"
			],
			"Resource": "*"
		}
	]
}